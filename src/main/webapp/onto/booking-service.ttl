@prefix cot: <http://localhost:8080/cottage-booking/onto/cottage.owl#> .
@prefix : <http://localhost:8080/cottage-booking/onto/booking-service.owl#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Ontology of the SSWAP "Cottage booking" service: it describes the 
# service request (input) and the booking suggestions (output). The cottages
# themselves are described in the separate ontology cottage.owl.
# Lake distance in metres and City distance in kilometres.
# bookingEnd = bookingStart + numberOfDays -1.

<http://localhost:8080/cottage-booking/onto/booking-service.owl> a owl:Ontology ;
    owl:imports <http://localhost:8080/cottage-booking/onto/cottage.owl> ;
    rdfs:label "SSWAP Cottage Booking search service ontology"@en ;
    rdfs:comment "Messages used by the semantic search endpoint; suggestions are proposals, not confirmed reservations."@en .


# Classes


:BookingService a owl:Class .
    rdfs:label "Cottage booking service"@en ;
    rdfs:comment "Type of the SSWAP resource that searches for cottages and returns booking suggestions."@en .

:SearchRequest a owl:Class ;
    rdfs:subClassOf :BookingService ;
    rdfs:label "Cottage search request"@en ;
    rdfs:comment "Input (SSWAP subject) of the service: the requirements for a cottage booking."@en .

:SuggestionSet a owl:Class ;
    rdfs:label "Booking suggestion collection"@en .

:BookingSuggestion a owl:Class ;
    rdfs:subClassOf :BookingService ;
    rdfs:label "Cottage booking suggestion"@en ;
    rdfs:comment "Output (SSWAP object) of the service: one booking suggestion for one cottage and one period."@en .

:hasSuggestion a owl:ObjectProperty ;
    rdfs:domain :SuggestionSet ;
    rdfs:range :BookingSuggestion .

:forCottage a owl:ObjectProperty ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range cot:Cottage .


# ------------------- Input properties (SearchRequest) ---------------

:bookerName a owl:DatatypeProperty ;
    rdfs:domain :BookingService ;
    rdfs:range xsd:string ;
    rdfs:label "booker name"@en ;
    rdfs:comment "Name of the person who books. Given in the request and repeated in each booking suggestion."@en .

:requiredPlaces a owl:DatatypeProperty ;
    rdfs:domain :SearchRequest ;
    rdfs:range xsd:integer ;
    rdfs:label "required places"@en ;
    rdfs:comment "Minimum cottage capacity."@en .

:requiredBedrooms a owl:DatatypeProperty ;
    rdfs:domain :SearchRequest ;
    rdfs:range xsd:integer ;
    rdfs:label "required bedrooms"@en ;
    rdfs:comment "Minimum number of bedrooms."@en .

:maxLakeDistance a owl:DatatypeProperty ;
    rdfs:domain :SearchRequest ;
    rdfs:range xsd:integer ;
    rdfs:label "maximum lake distance"@en ;
    rdfs:comment "Maximum distance from the cottage to a lake, metres."@en .

:city a owl:DatatypeProperty ;
    rdfs:domain :SearchRequest ;
    rdfs:range xsd:string ;
    rdfs:label "City name"@en ;
    rdfs:comment "Desired nearest city name."@en .

:maxCityDistance a owl:DatatypeProperty ;
    rdfs:domain :SearchRequest ;
    rdfs:range xsd:decimal ;
    rdfs:label "maximum city distance"@en ;
    rdfs:comment "Maximum distance to city, kilometres."@en .

:numberOfDays a owl:DatatypeProperty ;
    rdfs:domain :SearchRequest ;
    rdfs:range xsd:integer ;
    rdfs:label "number of days"@en ;
    rdfs:comment "Number of occupied days."@en .
    
:startDate a owl:DatatypeProperty ;
    rdfs:domain :BookingService ;
    rdfs:range xsd:date ;
    rdfs:label "start date"@en ;
    rdfs:comment "Preferred start date, ISO-8601 in RDF."@en .

:maxShiftDays a owl:DatatypeProperty ;
    rdfs:domain :SearchRequest ;
    rdfs:range xsd:integer ;
    rdfs:label "date shift"@en ;
    rdfs:comment "Allowed plus/minus shift of preferred start date."@en .


# ------------------- Output properties (CottageBooking) --------------------


:bookingNumber a owl:DatatypeProperty ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range xsd:long ;
    rdfs:label "booking number"@en ;
    rdfs:comment "Unique number generated by the service for the booking suggestion."@en .

:cottageAddress a owl:DatatypeProperty ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range xsd:string ;
    rdfs:label "address"@en ;
    rdfs:comment "Address of the cottage."@en .

:imageUrl a owl:DatatypeProperty ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range xsd:anyURI ;
    rdfs:label "image"@en ;
    rdfs:comment "URL of an image of the cottage."@en .

:capacity a owl:DatatypeProperty ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range xsd:integer ;
    rdfs:label "capacity"@en ;
    rdfs:comment "Actual number of places (people) in the cottage."@en .

:bedrooms a owl:DatatypeProperty ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range xsd:integer ;
    rdfs:label "capacity"@en ;
    rdfs:comment "Actual number of places (people) in the cottage."@en .

:lakeDistance a owl:DatatypeProperty ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range xsd:integer ;
    rdfs:label "lake distance"@en ;
    rdfs:comment "Actual distance from the cottage to the lake, in meters."@en .


:nearestCity a owl:DatatypeProperty ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range xsd:string ;
    rdfs:label "city"@en ;
    rdfs:comment "Name of the nearest city of the cottage."@en .

:cityDistance a owl:DatatypeProperty ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range xsd:decimal ;
    rdfs:label "city distance"@en ;
    rdfs:comment "Actual distance from the cottage to the city, in kilometers."@en .

:startDate a owl:DatatypeProperty ;
    rdfs:label "booking start date"@en ;
    rdfs:comment "First day of the suggested booking (included)."@en ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range xsd:date .

:endDate a owl:DatatypeProperty ;
    rdfs:domain :BookingSuggestion ;
    rdfs:range xsd:date ;
    rdfs:label "booking end"@en ;
    rdfs:comment "Last day of the suggested booking (included)."@en .


#OWL cardinality restrictions describe required fields but do not by themselves
# validate completeness in the open-world semantics of OWL. Check in Java.


:SearchRequest rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :bookerName ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:SearchRequest rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :requiredPlaces ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:SearchRequest rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :requiredBedrooms ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:SearchRequest rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :maxLakeDistance ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:SearchRequest rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :city ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:SearchRequest rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :maxCityDistance ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:SearchRequest rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :numberOfDays ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:SearchRequest rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :startDate ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:SearchRequest rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :maxShiftDays ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :bookerName ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :bookingNumber ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :cottageAddress ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :imageUrl ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :capacity ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :bedrooms ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :lakeDistance ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :nearestCity ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :cityDistance ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :startDate ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

:BookingSuggestion rdfs:subClassOf [
    a owl:Restriction ; owl:onProperty :endDate ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .